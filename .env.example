# REQUIRED: 32-byte base64 or hex secret used to encrypt imported QA credentials locally.
# Generate one with: openssl rand -base64 32
QA_MASTER_KEY=change-me-before-use

# Claude Code executable. The local machine must already have Claude Code installed and authenticated.
CLAUDE_BIN=claude

# Optional model override, for example: claude-sonnet-5
CLAUDE_MODEL=

# EXTRA arguments for the QA session, MERGED into the defaults rather than replacing them.
#
# Leave this empty. The runner already passes everything a non-interactive QA run
# needs, and getting it wrong is how runs fail silently:
#   -p --output-format stream-json --verbose
#   --mcp-config ./.mcp.json --strict-mcp-config
#   --permission-mode bypassPermissions
#
# Setting CLAUDE_ARGS=-p here used to REPLACE that whole list, which dropped the
# permission mode. In non-interactive mode nothing can answer a prompt, so every
# tool call was denied and runs ended with no report. Arguments are now merged and
# a permission mode is always enforced, so that specific trap is closed — but
# there is still no reason to set this unless you know you need it.
CLAUDE_ARGS=

# Set to 1 to replace the default arguments entirely instead of merging. Advanced.
CLAUDE_ARGS_REPLACE=

# Local data directory. Keep this outside source control.
QA_DATA_DIR=.qa-data

# How many QA runs may execute at once across all projects. One active run per
# project is always enforced, so two sessions cannot mutate the same QA data.
QA_MAX_CONCURRENT_RUNS=2
